<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Logistic Map Dashboard</title>
    <!-- Load Plotly.js for high-performance web graphing -->
    <script src="https://plot.ly"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 20px;
            background-color: #f8f9fa;
            color: #212529;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
            background: #f1f3f5;
            padding: 15px;
            border-radius: 6px;
        }
        .control-group {
            display: flex;
            flex-direction: column;
        }
        label {
            font-weight: 600;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }
        input[type="range"] {
            width: 100%;
        }
        .value-display {
            font-weight: normal;
            color: #495057;
        }
        .charts {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 20px;
        }
        @media (max-width: 600px) {
            .charts { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Logistic Map & Cobweb System</h2>
    
    <!-- Dynamic Input Controls -->
    <div class="controls">
        <div class="control-group">
            <label>Growth Parameter (r): <span id="r-val" class="value-display">3.20</span></label>
            <input type="range" id="r-slider" min="2.4" max="4.0" step="0.01" value="3.2">
        </div>
        <div class="control-group">
            <label>Initial Value (x₀): <span id="x-val" class="value-display">0.20</span></label>
            <input type="range" id="x-slider" min="0.01" max="0.99" step="0.01" value="0.2">
        </div>
        <div class="control-group">
            <label>Iterations: <span id="iter-val" class="value-display">30</span></label>
            <input type="range" id="iter-slider" min="5" max="100" step="1" value="30">
        </div>
    </div>

    <!-- Graph Rendering Targets -->
    <div class="charts">
        <div id="bifurcation-plot"></div>
        <div id="cobweb-plot"></div>
    </div>
</div>

<script>
    // 1. Core Mathematical Logistic Engine
    function f(x, r) { return r * x * (1.0 - x); }

    // 2. Pre-calculate static background Bifurcation data points for fast execution
    const bifR = [];
    const bifX = [];
    const nR = 800; 
    const nIters = 400;
    const nLast = 100;

    for (let i = 0; i < nR; i++) {
        let r = 2.4 + (i / nR) * 1.6;
        let x = 0.5;
        for (let j = 0; j < nIters; j++) {
            x = f(x, r);
            if (j >= (nIters - nLast)) {
                bifR.push(r);
                bifX.push(x);
            }
        }
    }

    // 3. Setup Layout Profiles
    const commonLayout = {
        margin: { t: 40, b: 40, l: 50, r: 20 },
        hovermode: 'closest'
    };

    // 4. Main Update Loop Engine
    function updatePlots() {
        const rTarget = parseFloat(document.getElementById('r-slider').value);
        const x0 = parseFloat(document.getElementById('x-slider').value);
        const nCobweb = parseInt(document.getElementById('iter-slider').value);

        // Sync text labels
        document.getElementById('r-val').innerText = rTarget.toFixed(2);
        document.getElementById('x-val').innerText = x0.toFixed(2);
        document.getElementById('iter-val').innerText = nCobweb;

        // --- Panel 1: Render Bifurcation Plot ---
        const bifData = [
            { x: bifR, y: bifX, mode: 'markers', marker: { color: '#212529', size: 1, opacity: 0.15 }, type: 'scattergl', name: 'Attractor' },
            { x: [rTarget, rTarget], y:, mode: 'lines', line: { color: '#dc3545', width: 2, dash: 'dash' }, name: `r = ${rTarget}` }
        ];
        
        const layoutBif = {
            ...commonLayout,
            title: 'Bifurcation Diagram',
            xaxis: { title: 'Growth Parameter (r)', range: [2.4, 4.0] },
            yaxis: { title: 'Steady States (x)', range: [0, 1] },
            showlegend: false
        };
        Plotly.newPlot('bifurcation-plot', bifData, layoutBif);

        // --- Panel 2: Render Cobweb Plot ---
        // Construct curve grid mapping arrays
        const gridX = [], gridY = [];
        for (let i = 0; i <= 100; i++) {
            let px = i / 100;
            gridX.push(px);
            gridY.push(f(px, rTarget));
        }

        // Trace trajectory shifts
        const cobX = [], cobY = [];
        let currX = x0;
        for (let i = 0; i < nCobweb; i++) {
            let nextX = f(currX, rTarget);
            // Vertical movement
            cobX.push(currX, currX);
            cobY.push(currX, nextX);
            // Horizontal movement
            cobX.push(currX, nextX);
            cobY.push(nextX, nextX);
            currX = nextX;
        }

        const cobwebData = [
            { x: gridX, y: gridY, mode: 'lines', line: { color: '#0d6efd', width: 2.5 }, name: 'y=f(x)' },
            { x:, y:, mode: 'lines', line: { color: '#6c757d', width: 1.5, dash: 'dash' }, name: 'y=x' },
            { x: cobX, y: cobY, mode: 'lines', line: { color: '#dc3545', width: 1.2 }, name: 'Path' },
            { x: [x0], y: [x0], mode: 'markers', marker: { color: '#198754', size: 8 }, name: 'Start' }
        ];

        const layoutCob = {
            ...commonLayout,
            title: `Cobweb Trajectory Space`,
            xaxis: { title: 'x_n', range: [0, 1] },
            yaxis: { title: 'x_n+1', range: [0, 1] },
            yaxis: { scaleanchor: "x", scaleratio: 1 }, // Retain rigid geometric proportions
            showlegend: false
        };
        Plotly.newPlot('cobweb-plot', cobwebData, layoutCob);
    }

    // Attach real-time structural event listener updates to elements
    document.getElementById('r-slider').addEventListener('input', updatePlots);
    document.getElementById('x-slider').addEventListener('input', updatePlots);
    document.getElementById('iter-slider').addEventListener('input', updatePlots);

    // Initial Trigger Run
    updatePlots();
</script>
</body>
</html>
